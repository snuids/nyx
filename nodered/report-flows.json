    "type": "function",
    "z": "814ef76a3cda9374",
    "name": "function 9",
    "func": "var org = msg.headers.org;\nmsg.to = msg.payload;\nmsg.replyTo = \"noreply@energy.marmar.ovh\";\nmsg.topic = (org.task && org.task.mailSubject) ? org.task.mailSubject : \"NYX report\";\nmsg.payload = (org.task && org.task.mailTemplate) ? org.task.mailTemplate : \"\";\n// A report that produced no file (it failed) carries an empty download list: the placeholder becomes empty\n// instead of throwing, so the failure notification is actually sent.\nvar url = (org.downloads && org.downloads.length) ? org.downloads[0].url : \"\";\nmsg.payload = msg.payload.replace(/\\$URL\\$/g, url);\n\nreturn msg;",
