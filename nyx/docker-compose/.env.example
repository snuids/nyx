# Copy to .env (gitignored) in this directory and fill in before `docker-compose up -d`.
# docker-compose.yml references these variables and will fail if they are unset.

# PostgreSQL password (used by postgres, nyx_restapi and nodered)
PG_PASSWORD=

# ActiveMQ admin / STOMP client password (used by amqc and all API/worker containers)
AMQC_PASSWORD=

# Grafana API access (dashboard selector in the UI and the Grafana data export report)
# Use the direct Grafana URL reachable from the containers, not the cookie-protected
# /grafananyx proxy, and a read-only service account token.
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_VERIFY_SSL=true
GRAFANA_TIMEOUT=60
GRAFANA_MAX_DATAPOINTS=1000
GRAFANA_MAX_ROWS_PER_SHEET=100000
