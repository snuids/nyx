# Copy to .env (gitignored) in this directory and fill in before `docker-compose up -d`.
# docker-compose.yml references these variables and will fail if they are unset.

# PostgreSQL password (used by postgres, nyx_restapi and nodered)
PG_PASSWORD=

# ActiveMQ admin / STOMP client password (used by amqc and all API/worker containers)
AMQC_PASSWORD=
